import os
import yt_dlp

output_dir = r"world-cup-sentiment-analysis\data"
os.makedirs(output_dir, exist_ok=True)

# Definir la plantilla de salida apuntando a la carpeta data
output_template = os.path.join(output_dir, "%(title)s.%(ext)s")

ydl_opts = {
    'format': 'bestaudio/best',
    'postprocessors': [{
        'key': 'FFmpegExtractAudio',
        'preferredcodec': 'mp3',
        'preferredquality': '0', # 0 para la mejor calidad VBR
    }],
    'outtmpl': output_template,
}

with yt_dlp.YoutubeDL(ydl_opts) as ydl:
    ydl.download(['https://www.rtve.es/play/videos/copa-mundial-de-la-fifa-2026/final-espana-argentina-completo-mundial-2026/17162172/'])