import pandas as pd


def convertir_excel_a_csv(
    ruta_excel: str, ruta_csv: str, nombre_hoja: str | int = 0
) -> None:

    try:
        df = pd.read_excel(ruta_excel, sheet_name=nombre_hoja)

        df.to_csv(ruta_csv, index=False, encoding="utf-8-sig", sep=",")

        print(
            f"Conversión exitosa: '{ruta_excel}' guardado como '{ruta_csv}'."
        )

    except FileNotFoundError:
        print(f"Error: No se encontró el archivo en la ruta '{ruta_excel}'.")
    except Exception as e:
        print(f"Ha ocurrido un error durante el procesamiento: {e}")


